# Copy to .env to override defaults used by docker-compose.yml. All values below are the defaults.

# ---- Simulated clock ------------------------------------------------------------
SIM_START=2026-03-01T00:00:00+00:00   # simulated time at which the platform starts
SIM_DAY_SECONDS=300                   # real seconds per simulated day (300 = 5 min, 288x speed)
INTERVAL_MINUTES=15                   # smart-meter reporting interval (simulated minutes)

# ---- Simulated population & fault injection -------------------------------------------
NUM_HOUSEHOLDS=250
RANDOM_SEED=42
DUPLICATE_RATE=0.01                   # readings re-sent with the same event_id
INVALID_RATE=0.005                    # corrupted readings (negative/impossible kWh, missing id, future ts, bad JSON)
OUTAGE_RATE=0.0012                    # per meter per interval: meter goes offline and uploads late
TARIFF_BAD_ROW_RATE=0.01              # bad rows in the daily tariff extract
TARIFF_LATE_PROBABILITY=0.15          # share of days on which the tariff file lands 1-3.5 simulated hours late

# ---- Processing ----------------------------------------------------------------------
WATERMARK_SIM_MINUTES=120             # speed-layer event-time watermark
LOW_RENEWABLE_THRESHOLD=0.25          # daylight renewable share below which an alert is raised
STREAM_TRIGGER_SECONDS=10             # grid_state micro-batch interval (real seconds)
ARCHIVE_TRIGGER_SECONDS=20            # raw_ingest micro-batch interval (real seconds)

# ---- Credentials (local demo only) -------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
LOG_LEVEL=INFO
