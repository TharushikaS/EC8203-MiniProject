          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT grid_zone, renewable_share FROM (SELECT DISTINCT ON (grid_zone) * FROM rt_zone_metrics WHERE intervals_observed >= 2\n                   ORDER BY grid_zone, window_start DESC) z ORDER BY grid_zone"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
