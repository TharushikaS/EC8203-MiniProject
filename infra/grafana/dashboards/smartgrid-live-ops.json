    {
      "type": "table",
      "title": "Zone status (latest window, simulated time)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT grid_zone AS \"Zone\", to_char(window_start, 'YYYY-MM-DD HH24:MI') AS \"Window (sim)\",\n                       round(load_kw::numeric, 1) AS \"Load kW\", round(solar_kw::numeric, 1) AS \"Solar kW\",\n                       renewable_share AS \"Renewable\", active_meters || '/' || expected_meters AS \"Meters\",\n                       to_char(updated_at, 'HH24:MI:SS') AS \"Updated (real)\"\n                FROM (SELECT DISTINCT ON (grid_zone) * FROM rt_zone_metrics WHERE intervals_observed >= 2\n                   ORDER BY grid_zone, window_start DESC) z ORDER BY grid_zone"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Renewable"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
