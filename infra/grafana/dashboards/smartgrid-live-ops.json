        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Simulated time",
      "description": "Current simulated clock (1 day = 5 real minutes)",
      "datasource": {
        "type": "prometheus",
        "uid": "smartgrid-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "smartgrid-prom"
          },
          "expr": "max(smartgrid_sim_time_seconds) * 1000",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Grid load",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "smartgrid-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "smartgrid-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT sum(load_kw) AS load FROM (SELECT DISTINCT ON (grid_zone) * FROM rt_zone_metrics WHERE intervals_observed >= 2\n                   ORDER BY grid_zone, window_start DESC) z"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 3,
